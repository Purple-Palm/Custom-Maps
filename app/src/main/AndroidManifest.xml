<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The network monitor follows the app's default network and reads the Mobile data switch.
        Mapbox declares it too; declared here because the app now uses it itself.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The car's screen: the templates of a navigation app, and the surface the app draws its map on
        (maps-androidauto declares the second too; setting a surface callback without it throws).
        Neither is a runtime permission. Location in the background is not asked for here: Google
        Play reviews it, and the car's screen does not need it for now.
    -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:name=".CustomMapsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomMaps"
        tools:targetApi="31">

        <!--
            The car's screen (docs/STAGE-2.md, Manifest). Car API level 7 is the lowest the screens
            need; the host refuses the app when its own level is lower. The car's host draws the
            app's buttons in the theme's amber and graphite where they pass its contrast check.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/Theme.CustomMaps.Car" />

        <!--
            Portrait only: the panels are laid out for a tall screen, and in landscape they would
            cover Start. Phones keep this; from Android 16 large screens ignore it, and the Mapbox
            logo keeps its fixed strip at the bottom there too. Resizing (multi-window, foldables) is
            handled by Compose, so the map is not rebuilt for it. The keyboard resizes the content,
            so the panels and the logo move above it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The service Android Auto binds to, in the navigation category, in the app's one process.
            Exported without a permission: the host validator decides who may bind, by the host's
            signing certificate, which is what Google advises for this warning. Bound only, and for
            the car's main display only: no cluster, and no NAVIGATE action (a drive starts on the
            phone).
        -->
        <service
            android:name=".car.CustomMapsCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Read access to exported debug log files, granted only to the app picked in the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debuglog"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_log_paths" />
        </provider>
    </application>
</manifest>
