<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme only; the UI is drawn by Compose in the look the app decides, which also sets the
        window's own background. The theme stays graphite in both looks: the splash, and what Recents
        and a start from it show for the app, which leaves no picture of its screen there from Android
        13 on. A dark frame by day costs nothing; a light one at night would light up a dark car.
    -->
    <style name="Base.Theme.CustomMaps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:colorBackground">@color/graphite</item>
    </style>

    <style name="Theme.CustomMaps" parent="Base.Theme.CustomMaps" />

    <!--
        The car's screen, by the manifest's androidx.car.app.theme. Each colour has a light variant, for
        a mark on the host's dark ground, and a dark one, for a ground under bright text: amber and
        the day look's dark amber, the night look's platinum and graphite. The host uses them only
        where they pass its contrast check, and its own colours otherwise. No parent: it is no window
        theme and takes nothing of the phone's.
    -->
    <style name="Theme.CustomMaps.Car" parent="">
        <item name="carColorPrimary">@color/amber</item>
        <item name="carColorPrimaryDark">@color/amber_ink</item>
        <item name="carColorSecondary">@color/platinum</item>
        <item name="carColorSecondaryDark">@color/graphite</item>
    </style>
</resources>
