<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 to 11: only the settings and the trip session log are backed up. Everything else
    stays on this phone: the Mapbox token, the debug log, and the map, routing and search data
    the Mapbox SDKs keep in the app's files.
-->
<full-backup-content>
    <include domain="file" path="datastore/app_settings.preferences_pb" />
    <include domain="file" path="datastore/trip_log.preferences_pb" />
</full-backup-content>
