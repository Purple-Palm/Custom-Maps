<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: only the settings and the trip session log go into cloud backups and device
    transfers. Everything else stays on this phone: the Mapbox token, the debug log, and the map,
    routing and search data the Mapbox SDKs keep in the app's files.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/app_settings.preferences_pb" />
        <include domain="file" path="datastore/trip_log.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/app_settings.preferences_pb" />
        <include domain="file" path="datastore/trip_log.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
