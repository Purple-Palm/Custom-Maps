# Gradle
.gradle/
build/

# Kotlin compiler session data
.kotlin/

# Machine-specific configuration and secrets (see local.properties.example)
local.properties
keystore.properties

# Signing keys
*.jks
*.keystore
*.p12

# Key material that must never be committed, should it land in the working tree: base64 copies of
# keys, a service account's JSON key saved at the top of the repository, and files named after
# the secrets. Nested JSON files, such as map styles, are not matched.
*.b64
/*.json
*_BASE64.txt
*_PASSWORD.txt

# Build outputs copied outside build/
*.apk
*.aab

# IDE
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
*.hprof

# OS
.DS_Store
Thumbs.db
